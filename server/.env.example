# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=



# Cartesia (TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# OpenRouter (LLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

