# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=



# Cartesia (TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# OpenRouter (LLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Motion Falcon assistant content served by the protected Vercel endpoint
MOTION_FALCON_KNOWLEDGE_URL=https://your-vercel-domain/api/motion-falcon-knowledge
# Must match the secret configured in the Vercel project. Never add this to Vite variables.
MOTION_FALCON_KNOWLEDGE_TOKEN=

# Lead capture integrations. Keep all values server-only.
HUBSPOT_PRIVATE_APP_TOKEN=
CALENDLY_URL=https://calendly.com/your-account/project-conversation
RESEND_API_KEY=
EMAIL_FROM=Motion Falcon <hello@your-domain.com>

